<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Search bar at the top -->
    <include
        android:id="@+id/layout_searchbar"
        layout="@layout/layout_searchbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ScrollView for the main content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_searchbar">

        <!-- Main content container -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Grey box containing form fields -->
            <LinearLayout
                android:id="@+id/form_container"
                android:layout_width="400dp"
                android:layout_height="wrap_content"
                android:background="@drawable/border_box"
                android:orientation="vertical"
                android:padding="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:fontFamily="@font/quicksand"
                    android:text="@string/summary_1_data_question_text"
                    android:textColor="@color/primary_color"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Region Spinner -->

                <!-- Comuna Spinner -->
                <Spinner
                    android:id="@+id/spinner_region"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/rounded_border_spinner"
                    android:dropDownVerticalOffset="8dp"
                    android:foregroundGravity="center"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="0dp"
                    android:popupBackground="#FFFFFF"
                    android:spinnerMode="dropdown"
                    android:textAlignment="center" />

                <Spinner
                    android:id="@+id/spinner_comuna"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/rounded_border_spinner"
                    android:dropDownVerticalOffset="8dp"
                    android:foregroundGravity="center"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="0dp"
                    android:popupBackground="#FFFFFF"
                    android:spinnerMode="dropdown"
                    android:textAlignment="center" />

                <!-- Street Label and Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/quicksand"
                    android:text="@string/summary_2_address_label"
                    android:textColor="@color/deep_green"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/street_name_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/rounded_shopping_edittext"
                    android:fontFamily="@font/quicksand"
                    android:hint="@string/summary_2_address_hint"
                    android:inputType="text|textAutoComplete"
                    android:minHeight="48dp"
                    android:padding="10dp"
                    tools:ignore="Autofill" />

                <!-- Number Label and Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/quicksand"
                    android:text="@string/summary_2_number_label"
                    android:textColor="@color/deep_green"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/street_number_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/rounded_shopping_edittext"
                    android:fontFamily="@font/quicksand"
                    android:hint="@string/summary_2_addressnum_hint"
                    android:inputType="number"
                    android:padding="10dp"
                    tools:ignore="Autofill" />

                <!-- Department Label and Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/quicksand"
                    android:text="@string/summary_2_address_house_label"
                    android:textColor="@color/deep_green"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/department_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/rounded_shopping_edittext"
                    android:fontFamily="@font/quicksand"
                    android:hint="@string/summary_2_opcional_hint"
                    android:inputType="text|textAutoComplete"
                    android:minHeight="48dp"
                    android:padding="10dp"
                    tools:ignore="Autofill,DuplicateSpeakableTextCheck" />

                <!-- Reference Label and Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/quicksand"
                    android:text="@string/summary_2_reference_label"
                    android:textColor="@color/deep_green"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/reference_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/rounded_shopping_edittext"
                    android:fontFamily="@font/quicksand"
                    android:hint="@string/register_next_card_info"
                    android:inputType="text|textAutoComplete"
                    android:padding="10dp"
                    tools:ignore="Autofill" />

                <!-- Receiver Label and Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/quicksand"
                    android:text="@string/summary_2_whoreceives_label"
                    android:textColor="@color/deep_green"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/receiver_name_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_shopping_edittext"
                    android:fontFamily="@font/quicksand"
                    android:hint="@string/summary_2_receivername_placeholder"
                    android:inputType="text|textAutoComplete"
                    android:minHeight="48dp"
                    android:padding="10dp"
                    tools:ignore="Autofill" />

            </LinearLayout>

            <!-- Modify Information Text - Outside the grey box -->
            <TextView
                android:id="@+id/TextViewInformation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/quicksand"
                android:text="@string/summary_1_modifyinfo_label"
                android:textColor="@color/primary_color"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/form_container" />

            <!-- Next Button - Outside the grey box -->
            <Button
                android:id="@+id/btn_siguiente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/rounded_button"
                android:elevation="0dp"
                android:fontFamily="@font/quicksand"
                android:text="@string/summary_2_finalize_button_text"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/TextViewInformation" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>


